    {
      "@id": "urn:int-esseric:3dcb2a1d-6f90-4a6f-ac6d-40e3d9674330",
      "@type": "Activity",
      "name": {
        "@type": "ObjectName",
        "name": "Prepare the location file"
      },
      "identifier": {
        "@type": "Identifier",
        "ddiIdentifier": {
          "@type": "InternationalRegistrationDataIdentifier",
          "dataIdentifier": "3dcb2a1d-6f90-4a6f-ac6d-40e3d9674330",
          "registrationAuthorityIdentifier": "int.esseric",
          "versionIdentifier": "1"
        }
      },
      "description": "Build the id, coordinate and interview-date file the downloads run on. Test run: 100 cases sampled from the CRONOS3 file with synthetic coordinates. Production: geo-impute the postcodes of all 9,677 respondents into id,latitude,longitude,interview_date (D7.1).",
      "displayLabel": {
        "@type": "LabelForDisplay",
        "languageSpecificString": {
          "@type": "LanguageString",
          "content": "Location file",
          "language": "en"
        }
      },
      "start": "2026-09-21T20:20:00Z",
      "end": "2026-09-21T20:20:00Z",
