          "uri": "urn:int-esseric:0a2c46eb-f2e4-49ce-919d-13320f7c1bbd"
        }
      ],
      "entityProduced": [
        {
          "@type": "Reference",
          "uri": "urn:int-esseric:e9d264d0-e979-43bb-856c-e4c89dde8d44"
        }
      ],
      "standardModelMapping": {
