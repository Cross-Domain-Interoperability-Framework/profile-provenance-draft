    {
      "@id": "urn:int-esseric:sogreen-om-test-wf",
      "@type": "Sequence",
      "name": {
        "@type": "ObjectName",
        "name": "SoGreen contextual data \u2013 Open-Meteo raw weather and air quality (test run, 100 locations)"
      },
      "identifier": {
        "@type": "Identifier",
        "ddiIdentifier": {
          "@type": "InternationalRegistrationDataIdentifier",
          "dataIdentifier": "sogreen-om-test-wf",
          "registrationAuthorityIdentifier": "int.esseric",
          "versionIdentifier": "1"
        }
      },
      "description": "Retrieval of the raw climate and air-quality input variables for the SoGreen integrated dataset (SoGreen D7.3 'Paper on Methodologies and Provenance in Data Integration', Section 5, Table 2). SoGreen (Horizon Europe, grant 101188188) links survey responses from ESS/CRONOS3, SHARE and GGP to the local weather and air quality at the time of interview. For each case a plausible residential point is drawn inside the respondent's region (pseudonymity-preserving geo-imputation, D7.1), and daily weather (Open-Meteo Historical Weather API, ERA5-Seamless) and hourly air quality (Open-Meteo Air Quality API, CAMS Europe 0.1\u00b0) are retrieved at that point from 2024-01-01, covering the 365 days before every 2025\u201326 interview. A 1991\u20132020 weather baseline supports the anomalies. THIS IS A TEST RUN: 100 CRONOS3 ids sampled by country with their real interview date but a random synthetic coordinate inside the country; the coordinates are not respondent locations. The production run will use the geo-imputed points for all 9,677 CRONOS3 respondents. Derived variables (D7.3 Tables 4\u20137) will be added as later activities.",
      "displayLabel": {
        "@type": "LabelForDisplay",
        "languageSpecificString": {
          "@type": "LanguageString",
          "content": "SoGreen Open-Meteo \u2013 raw data test run",
          "language": "en"
        }
      },
      "informs": "urn:int-esseric:56b09350-298d-4a37-b764-889df8d91b43-pa",
      "invokes": [
        "urn:int-esseric:3dcb2a1d-6f90-4a6f-ac6d-40e3d9674330",
        "urn:int-esseric:7f21fe87-494b-4053-b05f-615b9ad8ae80",
        "urn:int-esseric:991226ee-bc4b-4b10-8433-5e0065fb8f79"
      ],
      "has_SequencePosition": [
        "urn:int-esseric:sogreen-om-test-wf-sp-0",
        "urn:int-esseric:sogreen-om-test-wf-sp-1",
        "urn:int-esseric:sogreen-om-test-wf-sp-2"
      ]
    },
