    {
      "@id": "urn:int-esseric:96032b1d-6add-4cb0-8f4c-6e6cb2a03173",
      "@type": "Activity",
      "name": {
        "@type": "ObjectName",
        "name": "Retrieve raw weather data \u2013 Open-Meteo Historical Weather API"
      },
      "identifier": {
        "@type": "Identifier",
        "ddiIdentifier": {
          "@type": "InternationalRegistrationDataIdentifier",
          "dataIdentifier": "96032b1d-6add-4cb0-8f4c-6e6cb2a03173",
          "registrationAuthorityIdentifier": "int.esseric",
          "versionIdentifier": "1"
        }
      },
      "description": "Download the 8 daily weather variables of D7.3 Table 2 (ERA5-Seamless) at every location from 2024-01-01, optionally the 1991\u20132020 baseline (planned). One Parquet file per location plus a provenance JSON per run; resumable. Test run on the free tier with --sleep 2; the ~10k production run needs --apikey.",
      "displayLabel": {
        "@type": "LabelForDisplay",
        "languageSpecificString": {
          "@type": "LanguageString",
          "content": "Retrieve weather",
          "language": "en"
        }
      },
      "start": "2026-09-21T20:07:56Z",
      "end": "2026-09-22T07:39:01Z",
