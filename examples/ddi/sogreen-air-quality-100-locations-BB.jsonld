      ]
    },
    {
      "@id": "urn:int-esseric:0d227bd0-5bae-4396-829b-281cc670d170",
      "@type": "Step",
      "name": {
        "@type": "ObjectName",
        "name": "Sample 100 test locations \u2013 make_test_locations.py"
      },
      "identifier": {
        "@type": "Identifier",
        "ddiIdentifier": {
          "@type": "InternationalRegistrationDataIdentifier",
          "dataIdentifier": "0d227bd0-5bae-4396-829b-281cc670d170",
          "registrationAuthorityIdentifier": "int.esseric",
          "versionIdentifier": "1"
        }
      },
      "description": "python make_test_locations.py (defaults: -n 100 --seed 20260921). Keeps respondents with an interview date in the 11 SoGreen countries, draws a country-stratified sample, assigns a uniform random point inside a land-heavy country bounding box and takes the interview date from w6inwds. Output coordinates are synthetic.",
      "displayLabel": {
        "@type": "LabelForDisplay",
        "languageSpecificString": {
          "@type": "LanguageString",
          "content": "Sample test locations",
          "language": "en"
        }
      },
      "start": "2026-09-21T20:20:00Z",
      "end": "2026-09-21T20:20:00Z",
