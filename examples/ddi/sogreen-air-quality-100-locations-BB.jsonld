          "versionIdentifier": "1"
        }
      },
      "description": "Download the 5 hourly pollutant concentrations of D7.3 Table 2 (CAMS Europe 0.1\u00b0) at every location from 2024-01-01. One Parquet file per location plus a provenance JSON per run; resumable. Recent dates come from the CAMS near-real-time analysis, not yet the validated reanalysis.",
      "displayLabel": {
        "@type": "LabelForDisplay",
        "languageSpecificString": {
          "@type": "LanguageString",
          "content": "Retrieve air quality",
          "language": "en"
        }
      },
