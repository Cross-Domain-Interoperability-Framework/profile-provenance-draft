      ]
    },
    {
      "@id": "urn:int-esseric:991226ee-bc4b-4b10-8433-5e0065fb8f79",
      "@type": "Activity",
      "name": {
        "@type": "ObjectName",
        "name": "Prepare raw air-quality data"
      },
      "identifier": {
        "@type": "Identifier",
        "ddiIdentifier": {
          "@type": "InternationalRegistrationDataIdentifier",
          "dataIdentifier": "991226ee-bc4b-4b10-8433-5e0065fb8f79",
          "registrationAuthorityIdentifier": "int.esseric",
          "versionIdentifier": "1"
        }
      },
      "description": "Obtain and check the raw hourly air-quality input for every location (D7.3 Section 5, Table 2): pm10, pm2_5, nitrogen_dioxide, sulphur_dioxide and ozone (\u00b5g/m\u00b3) from the Open-Meteo Air Quality API, domain cams_europe (0.1\u00b0), hourly in local time (timezone=auto). Two sub-activities: retrieval (GSBPM 4.3) and completeness check of the files (GSBPM 5.3). Caveat: the validated CAMS European reanalysis lags about two years, so 2025\u201326 values come from the CAMS Europe near-real-time analysis on the same grid (D7.3 \u00a73.3 says 'reanalysis'). Test run: 100 locations, 2024-01-01 to 2026-09-20, 100 files written, 0 failed, check passed.",
      "displayLabel": {
        "@type": "LabelForDisplay",
        "languageSpecificString": {
          "@type": "LanguageString",
          "content": "Raw air-quality data",
          "language": "en"
        }
