    {
      "@id": "urn:int-esseric:7f21fe87-494b-4053-b05f-615b9ad8ae80",
      "@type": "Activity",
      "name": {
        "@type": "ObjectName",
        "name": "Prepare raw weather data"
      },
      "identifier": {
        "@type": "Identifier",
        "ddiIdentifier": {
          "@type": "InternationalRegistrationDataIdentifier",
          "dataIdentifier": "7f21fe87-494b-4053-b05f-615b9ad8ae80",
          "registrationAuthorityIdentifier": "int.esseric",
          "versionIdentifier": "1"
        }
      },
      "description": "Obtain and check the raw daily weather input for every location (D7.3 Section 5, Table 2): temperature_2m_mean/max/min, apparent_temperature_mean/max/min, precipitation_sum and wind_gusts_10m_max (m/s) from the Open-Meteo Historical Weather API, model pinned to era5_seamless (ERA5-Land 0.1\u00b0 + ERA5 0.25\u00b0) so that the 2024\u201326 interview period and the 1991\u20132020 baseline come from the same model instead of the API's 'best match' (ECMWF IFS from 2017). Daily values are local calendar days (timezone=auto), matching the interview date. Two sub-activities: retrieval (GSBPM 4.3) and completeness check of the files (GSBPM 5.3). Test run: 100 locations, 2024-01-01 to 2026-09-14 (ERA5 lag of ~5\u20137 days), 100 files written, 0 failed, check passed. The 1991\u20132020 baseline is planned for the production run with the commercial key.",
      "displayLabel": {
        "@type": "LabelForDisplay",
        "languageSpecificString": {
          "@type": "LanguageString",
          "content": "Raw weather data",
          "language": "en"
        }
      },
      "start": "2026-09-21T20:07:00Z",
      "end": "2026-09-24T09:14:00Z",
      "standardModelMapping": {
