          "registrationAuthorityIdentifier": "int.esseric",
          "versionIdentifier": "1"
        }
      },
      "description": "Download historical and future climate projections from the Copernicus Climate Data Store (CDS) using the EU-CORDEX regional climate model. Data are retrieved for the selected area of interest and cropped to the study area before storage.",
      "displayLabel": {
        "@type": "LabelForDisplay",
        "languageSpecificString": {
          "@type": "LanguageString",
          "content": "Download EU-CORDEX climate variables",
          "language": "en"
        }
      },
      "entityUsed": [
        {
          "@type": "Reference",
          "uri": "https://cds.climate.copernicus.eu/datasets/projections-cordex-domains-single-levels"
        }
      ],
