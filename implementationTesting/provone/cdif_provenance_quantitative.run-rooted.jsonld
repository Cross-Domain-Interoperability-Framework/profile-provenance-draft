          "rdfs:label": "Water sampling",
          "provone:hasInPort": {
            "@id": "ex:smFeatureIn",
            "@type": "provone:Port",
            "provone:connectsTo": {
              "@id": "ex:chFeature",
              "@type": "provone:Channel"
            }
          },
          "provone:hasOutPort": {
            "@id": "ex:smSampleOut",
            "@type": "provone:Port",
            "provone:connectsTo": {
              "@id": "ex:chSample",
              "@type": "provone:Channel"
            }
          }
        },
        {
          "@id": "ex:absorbanceProgram",
          "@type": "provone:Program",
