      "@id": "ex:analyst01",
      "@type": "provone:User"
    },
    "prov:hadPlan": {
      "@id": "ex:concentrationWorkflow",
      "@type": "provone:Workflow",
      "rdfs:label": "Concentration determination workflow",
      "provone:hasSubProgram": [
        {
          "@id": "ex:samplingProgram",
