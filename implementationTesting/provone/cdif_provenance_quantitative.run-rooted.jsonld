          "provone:hasInPort": [
            {
              "@id": "ex:abSampleIn",
              "@type": "provone:Port",
              "provone:connectsTo": {"@id": "ex:chSample"}
            },
            {
              "@id": "ex:abInstrumentIn",
              "@type": "provone:Port",
              "provone:hasDefaultParam": {"@id": "ex:spectrophotometer01"}
            },
            {
