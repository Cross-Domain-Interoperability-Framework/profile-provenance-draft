      "schema:agent": {"@id": "ex:researcherA"},
      "schema:object": {"@id": "ex:codeAssignment"},
      "schema:result": {
        "@id": "ex:theme01",
        "@type": "schema:Thing",
        "schema:name": "Theme 01",
        "schema:description": "A theme inferred from the code assignments.",
        "schema:additionalType": [
          {"@id": "ex:Theme"},
          {"@id": "ex:Finding"}
        ]
      }
    },
    {
      "@id": "ex:codingAssessment",
      "@type": "schema:CreateAction",
      "schema:name": "Coding uncertainty assessment",
      "schema:description": "A second researcher coded the segment independently, and the two codings were compared.",
      "schema:additionalType": [
        {"@id": "https://w3id.org/cdif/concepts/provenance/activity/QualityControlData"},
        {"@id": "ex:Assessment"},
        {"@id": "ex:UncertaintyAssessment"}
      ],
      "schema:actionStatus": "http://schema.org/CompletedActionStatus",
      "schema:agent": {
        "@id": "ex:researcherB",
        "@type": "schema:Person",
        "schema:name": "Researcher B",
        "schema:contactPoint": {
          "@id": "ex:researcherB-contactPoint",
          "@type": "schema:ContactPoint",
          "schema:email": "researcher.b@example.org"
        }
      },
      "schema:object": {"@id": "ex:codeAssignment"},
      "schema:result": {
        "@id": "ex:codingUncertainty",
        "@type": "schema:Thing",
        "schema:name": "Coding uncertainty",
        "schema:description": "Agreement between the first coding and an independent second coding.",
        "schema:additionalType": {"@id": "ex:UncertaintyObject"},
        "schema:additionalProperty": {
          "@id": "ex:codingUncertainty-additionalProperty-1",
          "@type": "schema:PropertyValue",
          "schema:name": "Inter-coder agreement (Cohen's kappa)",
          "schema:propertyID": "Cohen's kappa",
          "schema:value": 0.78
        }
      }
    },
    {
      "@id": "ex:themeValidation",
      "@type": "schema:CreateAction",
      "schema:name": "Theme validation",
      "schema:description": "The theme was checked against the coded data, taking the coding uncertainty into account, and accepted.",
      "schema:additionalType": [
        {"@id": "ex:Validation"},
        {"@id": "ex:Assessment"},
