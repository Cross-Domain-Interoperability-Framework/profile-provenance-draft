        "schema:additionalType": [
          {"@id": "ex:SourceData"},
          {"@id": "ex:SubmittedData"}
        ]
      },
      "schema:result": {
        "@id": "ex:responseSegment",
        "@type": "schema:Thing",
        "schema:name": "Response segment",
        "schema:description": "A segment of the submitted response, the unit of coding.",
        "schema:additionalType": [
          {"@id": "ex:ProcessedData"},
          {"@id": "ex:ResponseSegment"}
        ]
      }
    },
    {
      "@id": "ex:codingActivity",
      "@type": "schema:CreateAction",
      "schema:actionProcess": {
        "@id": "ex:codingProcedure",
        "@type": "schema:HowTo",
        "schema:name": "Qualitative coding, as performed",
        "schema:description": "Deductive coding of each segment against the codebook.",
        "schema:step": [
          {
            "@id": "ex:codingProcedure-step-1",
            "@type": "schema:HowToStep",
            "schema:name": "Read the segment in the context of the whole response",
            "schema:position": "1"
          },
          {
            "@id": "ex:codingProcedure-step-2",
            "@type": "schema:HowToStep",
            "schema:name": "Assign every codebook code whose definition the segment meets",
            "schema:position": "2"
          },
          {
            "@id": "ex:codingProcedure-step-3",
            "@type": "schema:HowToStep",
            "schema:name": "Write a memo for each assignment that needed judgement",
            "schema:position": "3"
          }
        ],
        "schema:isBasedOn": {
          "@id": "ex:codebookV2",
          "@type": "schema:HowTo"
        }
      },
      "schema:name": "Qualitative coding",
      "schema:description": "Codes from version 2 of the codebook were assigned to the response segment.",
      "schema:additionalType": [
        {"@id": "https://w3id.org/cdif/concepts/provenance/activity/DataClassificationAndCoding"},
        {"@id": "ex:Derivation"},
        {"@id": "ex:QualitativeCoding"}
      ],
      "schema:actionStatus": "http://schema.org/CompletedActionStatus",
      "schema:agent": {"@id": "ex:researcherA"},
      "schema:object": {"@id": "ex:responseSegment"},
      "schema:result": {
        "@id": "ex:codeAssignment",
        "@type": "schema:Thing",
        "schema:name": "Code assignment",
        "schema:description": "The codes assigned to the response segment, with the coder's memos.",
        "schema:additionalType": [
          {"@id": "ex:DerivedData"},
          {"@id": "ex:CodeAssignment"}
        ]
      },
      "schema:additionalProperty": {
        "@id": "ex:codingActivity-additionalProperty-1",
        "@type": "schema:PropertyValue",
        "schema:name": "Coding unit",
        "schema:propertyID": "coding unit",
        "schema:value": "response segment"
      }
    },
    {
      "@id": "ex:themeDevelopment",
      "@type": "schema:CreateAction",
      "schema:actionProcess": {
        "@id": "ex:analyticalFramework",
        "@type": "schema:HowTo"
      },
      "schema:name": "Theme development",
      "schema:description": "The code assignments were synthesized into a theme, following the analytical framework.",
      "schema:additionalType": [
        {"@id": "https://w3id.org/cdif/concepts/provenance/activity/Analysis"},
        {"@id": "ex:Inference"},
        {"@id": "ex:ThematicSynthesis"}
      ],
