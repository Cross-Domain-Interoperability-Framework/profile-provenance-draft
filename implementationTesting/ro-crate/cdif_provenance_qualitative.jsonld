      },
      "schema:name": "Text processing",
      "schema:description": "The submitted response was cleaned and split into segments, following the processing guide.",
      "schema:additionalType": [
        {"@id": "https://w3id.org/cdif/concepts/provenance/activity/DataTransformation"},
        {"@id": "ex:Processing"}
      ],
      "schema:startTime": "2026-11-05T09:00:00+00:00",
      "schema:endTime": "2026-11-05T09:10:00+00:00",
      "schema:actionStatus": "http://schema.org/CompletedActionStatus",
      "schema:agent": {
        "@id": "ex:researcherA",
        "@type": "schema:Person",
        "schema:name": "Researcher A",
        "schema:contactPoint": {
          "@id": "ex:researcherA-contactPoint",
          "@type": "schema:ContactPoint",
          "schema:email": "researcher.a@example.org"
        }
      },
      "schema:object": {
        "@id": "ex:submittedResponse",
        "@type": "schema:Thing",
        "schema:name": "Submitted response",
