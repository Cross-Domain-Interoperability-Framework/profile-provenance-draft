            },
            "schema:instrument": {"@id": "ex:pyrolysisOven"},
            "schema:position": "2"
          },
          {
            "@id": "ex:bennuGCSeparation",
            "@type": [
              "schema:CreateAction",
              "schema:HowToStep"
