            "schema:actionProcess": {
              "@id": "ex:bennuGCOvenProgram",
              "@type": "schema:HowTo",
              "schema:name": "GC oven program, as run",
              "schema:description": "Separate the pyrolysis products on a nonpolar fused silica capillary column with a temperature program from an initial hold, through a ramp, to a final hold.",
              "schema:step": [
                {
                  "@id": "ex:bennuGCOvenProgram-1",
                  "@type": "schema:HowToStep",
                  "schema:name": "Hold at 40 °C for 5 min",
                  "schema:position": "1"
                },
                {
                  "@id": "ex:bennuGCOvenProgram-2",
                  "@type": "schema:HowToStep",
                  "schema:name": "Ramp to 300 °C at about 3.5 °C/min",
                  "schema:position": "2"
                },
                {
                  "@id": "ex:bennuGCOvenProgram-3",
                  "@type": "schema:HowToStep",
                  "schema:name": "Hold at 300 °C until 87.79 min",
                  "schema:position": "3"
                }
              ],
              "schema:isBasedOn": {
                "@id": "ex:GCSeparation_Protocol",
                "@type": "schema:HowTo"
              }
            },
            "schema:name": "GC separation on an Rtx-5ms column",
            "schema:description": "Chromatographic separation on an Rtx-5ms column (30 m × 0.250 mm × 0.50 µm, 5 m guard), with split injection 10:1 at 300 °C and helium carrier at 1.500 mL/min. Run time 87.79 min.",
            "schema:actionStatus": "http://schema.org/CompletedActionStatus",
            "schema:agent": {"@id": "ex:NASA_GSFC"},
            "schema:object": [
              {"@id": "ex:helium"},
              {"@id": "ex:bennuPyrolysisProducts"},
              {
                "@id": "ex:bennuGCSeparation/parameter-1",
                "@type": "schema:PropertyValue",
                "schema:name": "Column",
                "schema:value": "Rtx-5ms, 30 m × 0.250 mm × 0.50 µm + 5 m guard",
                "schema:propertyID": "https://example.org/cdif-prov/param_columnType"
              },
              {
                "@id": "ex:bennuGCSeparation/parameter-2",
                "@type": "schema:PropertyValue",
                "schema:name": "Carrier gas flow",
                "schema:value": 1.5,
                "schema:unitText": "mL/min",
                "schema:propertyID": "https://example.org/cdif-prov/param_carrierGasFlow"
              },
              {
                "@id": "ex:bennuGCSeparation/parameter-3",
                "@type": "schema:PropertyValue",
                "schema:name": "Split ratio",
                "schema:value": "10:1",
                "schema:propertyID": "https://example.org/cdif-prov/param_splitRatio"
              },
              {
                "@id": "ex:bennuGCSeparation/parameter-4",
                "@type": "schema:PropertyValue",
                "schema:name": "Inlet temperature",
                "schema:value": 300,
                "schema:unitText": "°C",
                "schema:propertyID": "https://example.org/cdif-prov/param_inletTemp"
              }
            ],
            "schema:result": {
