            ],
            "schema:actionProcess": {
              "@id": "ex:bennuPyrolysisProcedure",
              "@type": "schema:HowTo",
              "schema:name": "Flash pyrolysis, as performed",
              "schema:description": "Flash heat the prepared sample to the target temperature at a controlled rate; carry the volatiles in helium through the heated transfer line to the GC inlet.",
              "schema:isBasedOn": {
                "@id": "ex:Pyrolysis_Protocol",
                "@type": "schema:HowTo"
              }
            },
            "schema:name": "Flash pyrolysis at about 600 °C",
            "schema:description": "Flash-heated at 10 °C/ms to about 600 °C. The volatiles were carried in helium through the heated transfer line (300 °C) to the GC inlet. Bulk samples may contain soluble organic matter, which produces thermal degradation products and rearrangements.",
