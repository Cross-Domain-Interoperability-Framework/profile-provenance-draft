              {
                "@id": "ex:pyrolysisOven",
                "@type": "schema:Product",
                "schema:name": "Pyrolysis oven",
                "schema:description": "Pyrolysis front-end interface coupled to the GC-MS. Flash heats at 10 °C/ms to temperatures up to 1300 °C."
              }
            ],
            "schema:position": "1"
          },
          {
            "@id": "ex:bennuPyrolysis",
            "@type": [
              "schema:CreateAction",
