ex:fes2Step1 a prov:Activity ;
    dcterms:isPartOf ex:fes2Run ;
    schema1:actionStatus schema1:CompletedActionStatus ;
    schema1:additionalProperty [ a schema1:PropertyValue ;
            schema1:name "pre-edge range end" ;
            schema1:propertyID "processing.pre_edge.pre2" ;
            schema1:unitText "eV" ;
            schema1:value -30 ],
        [ a schema1:PropertyValue ;
            schema1:name "rebin" ;
            schema1:propertyID "processing.rebin" ;
            schema1:value 0 ],
        [ a schema1:PropertyValue ;
