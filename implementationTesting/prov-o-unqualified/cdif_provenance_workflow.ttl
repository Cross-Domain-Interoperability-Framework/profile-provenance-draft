        [ a schema1:PropertyValue ;
            schema1:name "normalization polynomial order" ;
            schema1:propertyID "processing.pre_edge.nnorm" ;
            schema1:value 3 ],
        [ a schema1:PropertyValue ;
            schema1:name "pre-edge range start" ;
            schema1:propertyID "processing.pre_edge.pre1" ;
            schema1:unitText "eV" ;
            schema1:value -117 ] ;
    schema1:name "Normalize the absorption spectrum (Larch Athena)" ;
    schema1:position 1 ;
    prov:endedAtTime "2024-10-23T14:10:04.994552"^^xsd:dateTime ;
    prov:startedAtTime "2024-10-23T14:09:56.823447"^^xsd:dateTime ;
    prov:used ex:fes2_rt01_mar02.xmu,
