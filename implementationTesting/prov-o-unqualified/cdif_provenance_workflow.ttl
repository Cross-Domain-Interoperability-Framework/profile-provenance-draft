ex:fes2Step3 a prov:Activity ;
    dcterms:isPartOf ex:fes2Run ;
    schema1:actionStatus schema1:CompletedActionStatus ;
    schema1:additionalProperty [ a schema1:PropertyValue ;
            schema1:name "initial deltaR" ;
            schema1:propertyID "feff_outputs[0].selection.paths[*].deltar.value" ;
            schema1:unitText "Å" ;
