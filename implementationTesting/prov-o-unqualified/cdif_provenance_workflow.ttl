        [ a schema1:PropertyValue ;
            schema1:name "normalization range start" ;
            schema1:propertyID "processing.pre_edge.norm1" ;
            schema1:unitText "eV" ;
            schema1:value 150 ],
        [ a schema1:PropertyValue ;
            schema1:name "input format" ;
            schema1:propertyID "merge_inputs.format.format" ;
