ex:FeS2_athena.prj a schema:MediaObject,
        prov:Entity ;
    schema:description "Athena project with the normalized spectrum." ;
    schema:encodingFormat "application/octet-stream" ;
    schema:name "FeS2_athena" ;
    prov:qualifiedGeneration [ a prov:Generation ;
            prov:activity ex:fes2Step1 ;
            prov:atTime "2024-10-23T14:10:04.994552"^^xsd:dateTime ] .

ex:analyst02 a schema:Person,
        prov:Person ;
    schema:identifier [ a schema:PropertyValue ;
            schema:propertyID <https://registry.identifiers.org/registry/orcid> ;
            schema:url "https://orcid.org/0000-0000-0000-0002" ;
            schema:value "0000-0000-0000-0002" ] ;
    schema:name "Sam Rivera" .

ex:fes2FitResults a schema:Dataset,
        prov:Entity ;
    schema:dateModified "2024-10-23" ;
    schema:description "Results of fitting the room-temperature Fe K-edge EXAFS of FeS2 with Larch in Galaxy: the fit report and the fit plots. The computational-workflow scenario of the provenance-approach comparison (implementationTesting/APPROACHES.md), based on the Galaxy run in examples/FeS2-Analysis.actions.cdifprov.json." ;
    schema:identifier [ a schema:PropertyValue ;
            schema:propertyID <https://registry.identifiers.org/registry/doi> ;
            schema:url "https://doi.org/10.0000/example-fes2-exafs" ;
            schema:value "doi:10.0000/example-fes2-exafs" ] ;
    schema:name "EXAFS fit of FeS2 (pyrite) at room temperature" ;
    schema:subjectOf ex:fes2FitResults-record ;
    prov:qualifiedGeneration [ a prov:Generation ;
            prov:activity ex:fes2Run ;
            prov:atTime "2024-10-23T14:10:18.969215"^^xsd:dateTime ] .

ex:fes2FitResults-record a schema:Dataset ;
    dcterms:conformsTo <https://w3id.org/cdif/core/2.0>,
        <https://w3id.org/cdif/provenance/2.0> ;
    schema:about ex:fes2FitResults ;
    schema:additionalType dcat:CatalogRecord .

ex:fes2Step4 a prov:Activity ;
    schema:actionStatus schema:CompletedActionStatus ;
    schema:additionalProperty [ a schema:PropertyValue ;
            schema:name "k range start" ;
            schema:propertyID "fit_vars.kmin" ;
            schema:unitText "Å⁻¹" ;
            schema:value 0 ],
        [ a schema:PropertyValue ;
            schema:name "k range end" ;
            schema:propertyID "fit_vars.kmax" ;
            schema:unitText "Å⁻¹" ;
            schema:value 20 ],
        [ a schema:PropertyValue ;
            schema:name "window" ;
            schema:propertyID "fit_vars.window" ;
            schema:value "kaiser" ],
        [ a schema:PropertyValue ;
            schema:name "k weight" ;
            schema:propertyID "fit_vars.kweight" ;
            schema:value 2 ],
        [ a schema:PropertyValue ;
            schema:name "R range end" ;
            schema:propertyID "fit_vars.rmax" ;
            schema:unitText "Å" ;
            schema:value 10 ],
        [ a schema:PropertyValue ;
            schema:name "fit space" ;
            schema:propertyID "fit_vars.fitspace" ;
            schema:value "r" ],
        [ a schema:PropertyValue ;
            schema:name "R range start" ;
            schema:propertyID "fit_vars.rmin" ;
            schema:unitText "Å" ;
            schema:value 0 ],
        [ a schema:PropertyValue ;
            schema:name "execution" ;
            schema:propertyID "execution.execution" ;
            schema:value "parallel" ],
        [ a schema:PropertyValue ;
            schema:name "window width dk" ;
            schema:propertyID "fit_vars.dk" ;
            schema:unitText "Å⁻¹" ;
            schema:value 4 ] ;
    schema:name "Fit the paths to the spectrum (Larch Artemis)" ;
    schema:position 4 ;
    prov:endedAtTime "2024-10-23T14:10:18.969215"^^xsd:dateTime ;
    prov:qualifiedUsage [ a prov:Usage ;
            prov:entity ex:FeS2_athena.prj ;
            prov:hadRole ex:InputData ],
        [ a prov:Usage ;
            prov:entity ex:fes2FeffPaths ;
            prov:hadRole ex:InputData ],
        [ a prov:Usage ;
            prov:entity ex:fes2_gds.gds ;
            prov:hadRole ex:InputData ],
        [ a prov:Usage ;
            prov:entity ex:larchArtemis ;
            prov:hadRole ex:Software ],
        [ a prov:Usage ;
            prov:entity ex:fes2_sp.sp ;
            prov:hadRole ex:InputData ] ;
    prov:startedAtTime "2024-10-23T14:09:57.141933"^^xsd:dateTime .

ex:fes2Workflow a prov:Entity,
        prov:Plan .

ex:fes2_gds.gds a schema:MediaObject,
