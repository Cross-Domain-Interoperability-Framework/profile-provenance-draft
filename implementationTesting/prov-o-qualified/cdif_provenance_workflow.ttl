    schema:description "Fit in k and R space." ;
    schema:encodingFormat "image/png" ;
    schema:name "chikr_FeS2" ;
    prov:qualifiedGeneration [ a prov:Generation ;
            prov:activity ex:fes2Run ;
            prov:atTime "2024-10-23T14:10:18.969215"^^xsd:dateTime ] .

