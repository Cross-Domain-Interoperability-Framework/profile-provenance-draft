    schema:description "Plot of the normalized spectrum." ;
    schema:encodingFormat "image/png" ;
    schema:name "FeS2_plot" ;
    prov:qualifiedGeneration [ a prov:Generation ;
            prov:activity ex:fes2Step1 ;
            prov:atTime "2024-10-23T14:10:04.994552"^^xsd:dateTime ] .

