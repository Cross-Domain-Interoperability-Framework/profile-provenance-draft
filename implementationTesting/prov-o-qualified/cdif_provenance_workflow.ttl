    schema:name "fes2_gds" ;
    prov:qualifiedGeneration [ a prov:Generation ;
            prov:activity ex:fes2Step3 ;
            prov:atTime "2024-10-23T14:10:09.006182"^^xsd:dateTime ] .

ex:fes2_sp.sp a schema:MediaObject,
