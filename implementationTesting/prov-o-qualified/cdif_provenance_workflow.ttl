ex:1564889.cif a schema:MediaObject,
        prov:Entity ;
    schema:description "Crystal structure of FeS2 (pyrite), used to compute the scattering paths." ;
    schema:encodingFormat "chemical/x-cif" ;
    schema:name "1564889.cif" .

ex:fes2FeffPaths a schema:MediaObject,
        prov:Entity ;
    schema:description "FEFF scattering-path calculation for Fe in FeS2." ;
    schema:encodingFormat "application/zip" ;
    schema:name "FEFF output" ;
    prov:qualifiedGeneration [ a prov:Generation ;
            prov:activity ex:fes2Step2 ;
            prov:atTime "2024-10-23T14:10:05.023876"^^xsd:dateTime ] .

ex:fes2Step2 a prov:Activity ;
    schema:actionStatus schema:CompletedActionStatus ;
    schema:additionalProperty [ a schema:PropertyValue ;
            schema:name "input format" ;
            schema:propertyID "format.format" ;
            schema:value "cif" ],
        [ a schema:PropertyValue ;
            schema:name "cluster radius" ;
            schema:propertyID "format.radius" ;
            schema:unitText "Å" ;
            schema:value 4 ],
        [ a schema:PropertyValue ;
            schema:name "absorbing atom index" ;
            schema:propertyID "format.absorbing_atom" ;
            schema:value 0 ] ;
    schema:name "Compute scattering paths from the structure (Larch FEFF)" ;
    schema:position 2 ;
    prov:endedAtTime "2024-10-23T14:10:05.023876"^^xsd:dateTime ;
    prov:qualifiedUsage [ a prov:Usage ;
            prov:entity ex:1564889.cif ;
            prov:hadRole ex:InputData ],
        [ a prov:Usage ;
            prov:entity ex:larchFeff ;
            prov:hadRole ex:Software ] ;
    prov:startedAtTime "2024-10-23T14:09:56.910615"^^xsd:dateTime .

ex:fes2_rt01_mar02.xmu a schema:MediaObject,
        prov:Entity ;
    schema:description "Fe K-edge absorption spectrum of FeS2 at room temperature: energy and mu(E) columns." ;
    schema:encodingFormat "text/plain" ;
    schema:name "fes2_rt01_mar02.xmu" .

ex:fes2Step1 a prov:Activity ;
    schema:actionStatus schema:CompletedActionStatus ;
    schema:additionalProperty [ a schema:PropertyValue ;
            schema:name "normalization polynomial order" ;
            schema:propertyID "processing.pre_edge.nnorm" ;
            schema:value 3 ],
        [ a schema:PropertyValue ;
            schema:name "pre-edge range end" ;
            schema:propertyID "processing.pre_edge.pre2" ;
            schema:unitText "eV" ;
            schema:value -30 ],
        [ a schema:PropertyValue ;
            schema:name "normalization range start" ;
            schema:propertyID "processing.pre_edge.norm1" ;
            schema:unitText "eV" ;
            schema:value 150 ],
        [ a schema:PropertyValue ;
            schema:name "input format" ;
            schema:propertyID "merge_inputs.format.format" ;
            schema:value "plaintext" ],
        [ a schema:PropertyValue ;
            schema:name "normalization range end" ;
            schema:propertyID "processing.pre_edge.norm2" ;
            schema:unitText "eV" ;
            schema:value 850 ],
        [ a schema:PropertyValue ;
            schema:name "rebin" ;
            schema:propertyID "processing.rebin" ;
            schema:value 0 ],
        [ a schema:PropertyValue ;
            schema:name "pre-edge range start" ;
            schema:propertyID "processing.pre_edge.pre1" ;
            schema:unitText "eV" ;
            schema:value -117 ] ;
    schema:name "Normalize the absorption spectrum (Larch Athena)" ;
    schema:position 1 ;
    prov:endedAtTime "2024-10-23T14:10:04.994552"^^xsd:dateTime ;
    prov:qualifiedUsage [ a prov:Usage ;
            prov:entity ex:fes2_rt01_mar02.xmu ;
            prov:hadRole ex:InputData ],
        [ a prov:Usage ;
            prov:entity ex:larchAthena ;
            prov:hadRole ex:Software ] ;
    prov:startedAtTime "2024-10-23T14:09:56.823447"^^xsd:dateTime .

ex:fes2Step3 a prov:Activity ;
    schema:actionStatus schema:CompletedActionStatus ;
    schema:additionalProperty [ a schema:PropertyValue ;
            schema:name "initial S02" ;
            schema:propertyID "feff_outputs[0].selection.paths[*].s02.value" ;
            schema:value 1 ],
        [ a schema:PropertyValue ;
            schema:name "paths selected" ;
            schema:propertyID "feff_outputs[0].selection.paths" ;
            schema:value 3 ],
        [ a schema:PropertyValue ;
            schema:name "initial sigma2" ;
            schema:propertyID "feff_outputs[0].selection.paths[*].sigma2.value" ;
            schema:unitText "Å²" ;
            schema:value 3e-03 ],
        [ a schema:PropertyValue ;
            schema:name "selection" ;
            schema:propertyID "feff_outputs[0].selection.selection" ;
            schema:value "manual" ],
        [ a schema:PropertyValue ;
            schema:name "initial deltaR" ;
            schema:propertyID "feff_outputs[0].selection.paths[*].deltar.value" ;
            schema:unitText "Å" ;
            schema:value 0 ],
        [ a schema:PropertyValue ;
            schema:name "initial E0" ;
            schema:propertyID "feff_outputs[0].selection.paths[*].e0.value" ;
            schema:unitText "eV" ;
            schema:value 0 ] ;
    schema:name "Select the paths to fit (Larch select paths)" ;
    schema:position 3 ;
    prov:endedAtTime "2024-10-23T14:10:09.006182"^^xsd:dateTime ;
    prov:qualifiedUsage [ a prov:Usage ;
            prov:entity ex:fes2FeffPaths ;
            prov:hadRole ex:InputData ],
        [ a prov:Usage ;
            prov:entity ex:larchSelectPaths ;
            prov:hadRole ex:Software ] ;
    prov:startedAtTime "2024-10-23T14:09:57.007640"^^xsd:dateTime .

ex:fes2Run a prov:Activity,
        cdifact:Analysis ;
    dcterms:hasPart ex:fes2Step1,
        ex:fes2Step2,
        ex:fes2Step3,
        ex:fes2Step4 ;
    schema:actionStatus schema:CompletedActionStatus ;
    schema:description "One invocation of the Galaxy workflow FeS2 Analysis: normalize the measured spectrum, compute and select scattering paths from the crystal structure, and fit them to the spectrum." ;
    schema:name "FeS2 Analysis" ;
    prov:endedAtTime "2024-10-23T14:10:18.969215"^^xsd:dateTime ;
    prov:qualifiedAssociation [ a prov:Association ;
            prov:agent ex:analyst02 ;
            prov:hadPlan ex:fes2Workflow ] ;
    prov:qualifiedUsage [ a prov:Usage ;
            prov:entity ex:1564889.cif ;
            prov:hadRole ex:InputData ],
        [ a prov:Usage ;
            prov:entity ex:fes2_rt01_mar02.xmu ;
            prov:hadRole ex:InputData ],
        [ a prov:Usage ;
            prov:entity ex:galaxyEngine ;
            prov:hadRole ex:Software ] ;
    prov:startedAtTime "2024-10-23T14:09:38.754317"^^xsd:dateTime .

ex:Software a prov:Role .

ex:InputData a prov:Role .

