@prefix cdifact: <https://w3id.org/cdif/concepts/provenance/activity/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/cdif-prov/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:absorbanceMeasurementAttempt01 a prov:Activity ;
    dcterms:isPartOf ex:concentrationRun ;
    schema:actionStatus schema:FailedActionStatus ;
    schema:error "Air bubble in the cuvette gave an unstable reading; the reading was rejected and the measurement repeated." ;
    schema:name "Absorbance measurement, first attempt" ;
    schema:position 2 ;
    prov:endedAtTime "2026-11-05T10:13:00+00:00"^^xsd:dateTime ;
    prov:qualifiedAssociation [ a prov:Association ;
            prov:agent ex:analyst01 ] ;
    prov:qualifiedUsage [ a prov:Usage ;
            prov:entity ex:waterSample01 ;
            prov:hadRole ex:InputData ] ;
    prov:startedAtTime "2026-11-05T10:12:00+00:00"^^xsd:dateTime .

ex:HostingInstitution a prov:Role .

ex:absorbanceMeasurement a prov:Activity ;
    dcterms:isPartOf ex:concentrationRun ;
    schema:actionStatus schema:CompletedActionStatus ;
    schema:additionalProperty [ a schema:PropertyValue ;
            schema:name "Cuvette path length" ;
            schema:propertyID "cuvette path length" ;
            schema:unitText "cm" ;
            schema:value 1 ],
        [ a schema:PropertyValue ;
            schema:name "Colour development time" ;
            schema:propertyID "colour development time" ;
            schema:unitText "min" ;
            schema:value 10 ] ;
    schema:description "Colour reagent added to an aliquot of the sample; absorbance read at 540 nm against a reagent blank." ;
    schema:identifier "MEAS-2026-11-05-002" ;
    schema:name "Absorbance measurement" ;
    schema:position 3 ;
    prov:atLocation [ a schema:Place,
                prov:Location ;
            schema:additionalType "analytical laboratory" ;
            schema:geo [ a schema:GeoCoordinates ;
                    schema:latitude 4.695e+01 ;
                    schema:longitude 7.44e+00 ] ;
            schema:identifier "LAB-B12" ;
            schema:name "Analytical laboratory, room B12" ] ;
    prov:endedAtTime "2026-11-05T10:19:00+00:00"^^xsd:dateTime ;
    prov:qualifiedAssociation [ a prov:Association ;
            prov:agent ex:analyst01 ;
            prov:hadPlan ex:absorbanceProcedure ;
            prov:hadRole ex:DataCollector ],
        [ a prov:Association ;
            prov:agent ex:laboratory01 ;
            prov:hadRole ex:HostingInstitution ] ;
    prov:qualifiedUsage [ a prov:Usage ;
            prov:entity ex:waterSample01 ;
            prov:hadRole ex:InputData ],
        [ a prov:Usage ;
            prov:entity ex:cuvette01 ;
            prov:hadRole ex:Instrument ],
        [ a prov:Usage ;
            prov:entity ex:colourReagent01 ;
            prov:hadRole ex:Reagent ],
        [ a prov:Usage ;
            prov:entity ex:spectrophotometer01 ;
            prov:hadRole ex:Instrument ] ;
    prov:startedAtTime "2026-11-05T10:18:00+00:00"^^xsd:dateTime .

ex:absorbanceProcedure a prov:Entity,
        prov:Plan .

ex:absorbanceSource a schema:CreativeWork,
        prov:Entity ;
    schema:about ex:waterSample01 ;
    schema:description "Raw absorbance readings of the sample and the reagent blank." ;
    schema:encodingFormat "text/csv" ;
    schema:name "Absorbance data" ;
    schema:url "https://example.org/cdif-prov/data/absorbance.csv" ;
    prov:qualifiedGeneration [ a prov:Generation ;
            prov:activity ex:absorbanceMeasurement ;
            prov:atTime "2026-11-05T10:19:00+00:00"^^xsd:dateTime ] .

ex:blankCorrection a prov:Activity ;
    dcterms:isPartOf ex:concentrationRun ;
    schema:actionStatus schema:CompletedActionStatus ;
    schema:description "Reagent-blank absorbance subtracted from the sample absorbance." ;
    schema:name "Blank correction" ;
    schema:position 4 ;
    prov:endedAtTime "2026-11-05T10:21:04+00:00"^^xsd:dateTime ;
    prov:qualifiedAssociation [ a prov:Association ;
            prov:agent ex:analyst01 ;
            prov:hadPlan ex:blankCorrectionSpec ;
            prov:hadRole ex:Researcher ] ;
    prov:qualifiedUsage [ a prov:Usage ;
            prov:entity ex:analysisSoftware ;
            prov:hadRole ex:Software ],
        [ a prov:Usage ;
            prov:entity ex:absorbanceSource ;
            prov:hadRole ex:InputData ] ;
    prov:startedAtTime "2026-11-05T10:21:00+00:00"^^xsd:dateTime .

ex:blankCorrectionSpec a prov:Entity,
        prov:Plan .

ex:calibrationCurve a schema:CreativeWork,
        prov:Entity ;
    schema:description "Linear fit of absorbance against standard concentration." ;
    schema:encodingFormat "text/csv" ;
    schema:name "Calibration curve" ;
    schema:url "https://example.org/cdif-prov/data/calibration-curve.csv" ;
    prov:qualifiedGeneration [ a prov:Generation ;
            prov:activity ex:instrumentCalibration01 ;
            prov:atTime "2026-11-05T10:05:00+00:00"^^xsd:dateTime ] .

ex:calibrationDerivation a prov:Activity ;
    dcterms:isPartOf ex:concentrationRun ;
    schema:actionStatus schema:CompletedActionStatus ;
    schema:additionalProperty [ a schema:PropertyValue ;
            schema:name "Calibration intercept" ;
            schema:propertyID "calibration intercept" ;
            schema:value 3e-03 ],
        [ a schema:PropertyValue ;
            schema:name "Limit of detection" ;
            schema:propertyID "limit of detection" ;
            schema:unitText "mg/L" ;
            schema:value 2e-02 ],
        [ a schema:PropertyValue ;
            schema:name "Treatment of values below the limit of detection" ;
            schema:propertyID "treatment of values below the limit of detection" ;
            schema:value "Reported as '<0.02'; no value substituted." ],
        [ a schema:PropertyValue ;
            schema:name "Calibration slope" ;
            schema:propertyID "calibration slope" ;
            schema:unitText "L/mg" ;
            schema:value 4.12e-01 ] ;
    schema:description "Concentration computed from corrected absorbance with the calibration curve." ;
    schema:name "Calibration-based derivation" ;
    schema:position 5 ;
    prov:endedAtTime "2026-11-05T10:23:18+00:00"^^xsd:dateTime ;
    prov:qualifiedAssociation [ a prov:Association ;
            prov:agent ex:analyst01 ;
            prov:hadPlan ex:calibrationRelationship ;
            prov:hadRole ex:Researcher ] ;
    prov:qualifiedUsage [ a prov:Usage ;
            prov:entity ex:correctedAbsorbance ;
            prov:hadRole ex:InputData ],
        [ a prov:Usage ;
            prov:entity ex:analysisSoftware ;
            prov:hadRole ex:Software ],
        [ a prov:Usage ;
            prov:entity ex:calibrationCurve ;
            prov:hadRole ex:InputData ] ;
    prov:startedAtTime "2026-11-05T10:23:14+00:00"^^xsd:dateTime .

ex:calibrationRelationship a prov:Entity,
        prov:Plan .

ex:calibrationStandards01 a schema:ChemicalSubstance,
        schema:Thing,
        prov:Entity ;
    schema:additionalType <https://www.wikidata.org/entity/Q2356542> ;
    schema:name "Certified calibration standards, 0-2 mg/L, lot CS-0042" .

ex:colourReagent01 a schema:ChemicalSubstance,
        schema:Thing,
        prov:Entity ;
    schema:additionalType <https://www.wikidata.org/entity/Q2356542> ;
    schema:name "Colour-forming reagent, 2 mL" .

ex:concentrationDeterminationPlan a prov:Entity,
        prov:Plan .

ex:concentrationUncertainty a schema:CreativeWork,
        prov:Entity ;
    schema:encodingFormat "text/csv" ;
    schema:name "Concentration uncertainty" ;
    schema:url "https://example.org/cdif-prov/data/uncertainty.csv" ;
    prov:qualifiedGeneration [ a prov:Generation ;
            prov:activity ex:uncertaintyAssessment ] .

ex:correctedAbsorbance a schema:CreativeWork,
        prov:Entity ;
    schema:encodingFormat "text/csv" ;
    schema:name "Blank-corrected absorbance" ;
    schema:url "https://example.org/cdif-prov/data/corrected-absorbance.csv" ;
    prov:qualifiedGeneration [ a prov:Generation ;
            prov:activity ex:blankCorrection ;
            prov:atTime "2026-11-05T10:21:04+00:00"^^xsd:dateTime ] .

ex:cuvette01 a schema:Product,
        schema:Thing,
        prov:Entity ;
    schema:additionalType <https://www.wikidata.org/entity/Q3099911> ;
    schema:name "1 cm quartz cuvette" .

ex:instrumentCalibration01 a prov:Activity ;
    dcterms:isPartOf ex:concentrationRun ;
    schema:actionStatus schema:CompletedActionStatus ;
    schema:description "Absorbance of five certified standards measured to fit the response line used to convert sample absorbance to concentration." ;
    schema:name "Instrument calibration" ;
    schema:position 1 ;
    prov:endedAtTime "2026-11-05T10:05:00+00:00"^^xsd:dateTime ;
    prov:qualifiedAssociation [ a prov:Association ;
            prov:agent ex:analyst01 ;
            prov:hadRole ex:DataCollector ] ;
    prov:qualifiedUsage [ a prov:Usage ;
            prov:entity ex:calibrationStandards01 ;
            prov:hadRole ex:Reagent ],
        [ a prov:Usage ;
            prov:entity ex:spectrophotometer01 ;
            prov:hadRole ex:Instrument ] ;
    prov:startedAtTime "2026-11-05T09:40:00+00:00"^^xsd:dateTime .

ex:riverReach01 a schema:Place,
        prov:Entity ;
    schema:name "River reach the water was taken from" .

ex:uncertaintyAssessment a prov:Activity ;
    dcterms:isPartOf ex:concentrationRun ;
    schema:actionStatus schema:CompletedActionStatus ;
    schema:additionalProperty [ a schema:PropertyValue ;
            schema:name "Coverage factor" ;
            schema:propertyID "coverage factor" ;
            schema:value 2 ] ;
    schema:description "Combined standard uncertainty of the concentration from calibration, repeatability and volume contributions." ;
    schema:name "Uncertainty assessment" ;
    schema:position 6 ;
    prov:qualifiedAssociation [ a prov:Association ;
            prov:agent ex:analyst01 ;
            prov:hadPlan ex:uncertaintySpec ;
            prov:hadRole ex:Researcher ] ;
    prov:qualifiedUsage [ a prov:Usage ;
            prov:entity ex:analysisSoftware ;
            prov:hadRole ex:Software ],
        [ a prov:Usage ;
            prov:entity ex:concentration ;
            prov:hadRole ex:InputData ] .

ex:uncertaintySpec a prov:Entity,
        prov:Plan .

ex:validation a prov:Activity ;
    dcterms:isPartOf ex:concentrationRun ;
    schema:actionStatus schema:CompletedActionStatus ;
    schema:description "Concentration and its uncertainty checked against the acceptance criterion for the method." ;
    schema:name "Validation" ;
    schema:position 7 ;
    prov:qualifiedAssociation [ a prov:Association ;
            prov:agent ex:analyst01 ;
            prov:hadRole ex:Supervisor ] ;
    prov:qualifiedUsage [ a prov:Usage ;
            prov:entity ex:concentration ;
            prov:hadRole ex:InputData ],
        [ a prov:Usage ;
            prov:entity ex:concentrationUncertainty ;
            prov:hadRole ex:InputData ],
        [ a prov:Usage ;
            prov:entity ex:analysisSoftware ;
            prov:hadRole ex:Software ],
        [ a prov:Usage ;
            prov:entity ex:validationCriterion ;
            prov:hadRole ex:InputData ] .

ex:validationCriterion a schema:CreativeWork,
        prov:Entity ;
    schema:name "Acceptance criterion: relative expanded uncertainty at most 10 %" ;
    schema:url "https://example.org/cdif-prov/methods/acceptance-criterion" .

ex:validationResult a schema:Dataset,
        prov:Entity ;
    schema:description "cdifProv (schema.org) rendering of implementationTesting/prov-o-qualified/cdif_provenance_quantitative.ttl, the Dagstuhl quantitative scenario extended with illustrative sampling, instrument, reagent, tool and analyst. This file goes further than the master to exercise every slot the cdifProvenance schema offers: activity types from the CDIF activityType vocabulary, identifiers and descriptions, a full instrument description, software version, located places, procedures with steps and constants, vocabulary roles, an instrument calibration activity and a failed measurement attempt. Every fact beyond the Dagstuhl source is illustrative. See implementationTesting/APPROACHES.md for what this form keeps and loses." ;
    schema:name "Validation of the analyte concentration in water sample 01" ;
    schema:subjectOf ex:validationResult-record ;
    prov:qualifiedGeneration [ a prov:Generation ;
            prov:activity ex:validation ] .

ex:validationResult-record a schema:Dataset ;
    dcterms:conformsTo <https://w3id.org/cdif/provenance/2.0> ;
    schema:about ex:validationResult ;
    schema:additionalType dcat:CatalogRecord .

ex:waterSampling01 a prov:Activity,
        cdifact:Sampling ;
    schema:actionStatus schema:CompletedActionStatus ;
    schema:description "Grab sample of surface water from the river reach, filtered on site." ;
    schema:name "Water sampling" ;
    prov:atLocation [ a schema:Place,
                prov:Location ;
            schema:additionalType "river bank sampling point" ;
            schema:geo [ a schema:GeoCoordinates ;
                    schema:latitude 4.695e+01 ;
                    schema:longitude 7.45e+00 ] ;
            schema:name "Sampling point on the river reach" ] ;
    prov:endedAtTime "2026-11-04T08:15:00+00:00"^^xsd:dateTime ;
    prov:qualifiedAssociation [ a prov:Association ;
            prov:agent ex:analyst01 ;
            prov:hadRole ex:DataCollector ] ;
    prov:qualifiedUsage [ a prov:Usage ;
            prov:entity ex:riverReach01 ;
            prov:hadRole ex:InputData ] ;
    prov:startedAtTime "2026-11-04T08:10:00+00:00"^^xsd:dateTime .

ex:Reagent a prov:Role .

ex:Supervisor a prov:Role .

ex:concentration a schema:CreativeWork,
        prov:Entity ;
    schema:about ex:waterSample01 ;
    schema:encodingFormat "text/csv" ;
    schema:name "Analyte concentration" ;
    schema:url "https://example.org/cdif-prov/data/concentration.csv" ;
    prov:qualifiedGeneration [ a prov:Generation ;
            prov:activity ex:calibrationDerivation ;
            prov:atTime "2026-11-05T10:23:18+00:00"^^xsd:dateTime ] .

ex:spectrophotometer01 a schema:Product,
        schema:Thing,
        prov:Entity ;
    schema:additionalProperty [ a schema:PropertyValue ;
            schema:name "Spectral bandwidth" ;
            schema:propertyID "spectral bandwidth" ;
            schema:unitText "nm" ;
            schema:value 2 ],
        [ a schema:PropertyValue ;
            schema:name "Measurement wavelength" ;
            schema:propertyID "measurement wavelength" ;
            schema:unitText "nm" ;
            schema:value 540 ] ;
    schema:additionalType <https://www.wikidata.org/entity/Q3099911> ;
    schema:category [ a schema:DefinedTerm ;
            schema:name "UV-Vis spectrophotometer" ] ;
    schema:description "Double-beam UV-Vis spectrophotometer, 190-1100 nm." ;
    schema:hasPart [ a schema:Thing ;
            schema:name "Silicon photodiode detector" ],
        [ a schema:Thing ;
            schema:name "Grating monochromator" ],
        [ a schema:Thing ;
            schema:name "Deuterium and tungsten lamps" ] ;
    schema:identifier [ a schema:PropertyValue ;
            schema:propertyID "manufacturer serial number" ;
            schema:value "SN-000123" ] ;
    schema:manufacturer [ a schema:Organization ;
            schema:name "Example Instruments Ltd" ] ;
    schema:model [ a schema:ProductModel ;
            schema:name "SP-1000" ] ;
    schema:name "UV-Vis spectrophotometer" ;
    schema:owner ex:laboratory01 .

ex:DataCollector a prov:Role .

ex:Instrument a prov:Role .

ex:Researcher a prov:Role .

ex:laboratory01 a schema:Organization,
        prov:Organization ;
    schema:identifier [ a schema:PropertyValue ;
            schema:propertyID "laboratory accreditation number" ;
            schema:value "ACC-0000" ] ;
    schema:name "Analytical laboratory" .

ex:Software a prov:Role .

ex:analysisSoftware a schema:SoftwareApplication,
        prov:Entity ;
    schema:additionalType <https://www.wikidata.org/entity/Q7397> ;
    schema:identifier "https://example.org/cdif-prov/software/analysis/2.4.1" ;
    schema:name "Analysis software" ;
    schema:softwareVersion "2.4.1" ;
    schema:url "https://example.org/cdif-prov/software/analysis" .

ex:waterSample01 a schema:Thing,
        prov:Entity ;
    schema:description "500 mL surface water, filtered at 0.45 µm, kept at 4 °C until analysis." ;
    schema:name "Filtered water sample" ;
    prov:qualifiedGeneration [ a prov:Generation ;
            prov:activity ex:waterSampling01 ;
            prov:atTime "2026-11-04T08:15:00+00:00"^^xsd:dateTime ] .

ex:concentrationRun a prov:Activity,
        cdifact:Analysis ;
    schema:actionStatus schema:CompletedActionStatus ;
    schema:description "Analysis of water sample 01: instrument calibration, absorbance measurement (a failed attempt and its repeat), blank correction, derivation of concentration from the calibration, uncertainty assessment and validation against the acceptance criterion." ;
    schema:identifier [ a schema:PropertyValue ;
            schema:propertyID "laboratory run number" ;
            schema:value "RUN-2026-11-05-01" ] ;
    schema:name "Concentration determination run" ;
    prov:qualifiedAssociation [ a prov:Association ;
            prov:agent ex:analyst01 ;
            prov:hadPlan ex:concentrationDeterminationPlan ;
            prov:hadRole ex:Supervisor ] ;
    prov:qualifiedUsage [ a prov:Usage ;
            prov:entity ex:waterSample01 ;
            prov:hadRole ex:InputData ] ;
    prov:startedAtTime "2026-11-05T09:40:00+00:00"^^xsd:dateTime .

ex:analyst01 a schema:Person,
        prov:Person ;
    schema:affiliation ex:laboratory01 ;
    schema:contactPoint [ a schema:ContactPoint ;
            schema:email "ana.lima@example.org" ] ;
    schema:description "Analytical chemist; trained and authorised for the laboratory's UV-Vis absorbance method (illustrative qualification: there is no structured slot for qualifications or training)." ;
    schema:familyName "Lima" ;
    schema:givenName "Ana" ;
    schema:honorificPrefix "Dr" ;
    schema:identifier [ a schema:PropertyValue ;
            schema:propertyID <https://registry.identifiers.org/registry/orcid> ;
            schema:url "https://orcid.org/0000-0000-0000-0000" ;
            schema:value "0000-0000-0000-0000" ] ;
    schema:name "Ana Lima" .

ex:InputData a prov:Role .

