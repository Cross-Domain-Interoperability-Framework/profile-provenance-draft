    schema:description "Carrier gas for the pyrolysis products and the GC." ;
    schema:name "Helium" .

ex:pyrolysisOven a schema:Product,
        prov:Entity ;
    schema:additionalType <https://www.wikidata.org/entity/Q3099911> ;
    schema:description "Pyrolysis front-end interface coupled to the GC-MS. Flash heats at 10 °C/ms to temperatures up to 1300 °C." ;
    schema:name "Pyrolysis oven" .

