@prefix cdifact: <https://w3id.org/cdif/concepts/provenance/activity/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

cdifact:Observation a skos:Concept ;
    skos:definition "An activity which results in a record describing the object of interest."@en ;
    skos:inScheme cdifact:conceptScheme ;
    skos:notation "Observation" ;
    skos:prefLabel "Observation"@en ;
    skos:topConceptOf cdifact:conceptScheme .

