@prefix cdifact: <https://w3id.org/cdif/concepts/provenance/activity/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

cdifact:Sampling a skos:Concept ;
    skos:definition "An activity through which a portion of an entity is used to represent the whole, for some purpose."@en ;
    skos:inScheme cdifact:conceptScheme ;
    skos:notation "Sampling" ;
    skos:prefLabel "Sampling"@en ;
    skos:topConceptOf cdifact:conceptScheme .

