@prefix cdifact: <https://w3id.org/cdif/concepts/provenance/activity/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

cdifact:DataIntegration a skos:Concept ;
    skos:definition "An activity through which multiple data sources are combined into a coherent whole."@en ;
    skos:inScheme cdifact:conceptScheme ;
    skos:notation "DataIntegration" ;
    skos:prefLabel "Data Integration"@en ;
    skos:topConceptOf cdifact:conceptScheme .

