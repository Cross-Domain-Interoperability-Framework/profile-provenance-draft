@prefix cdifact: <https://w3id.org/cdif/concepts/provenance/activity/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

cdifact:DataValidation a skos:Concept ;
    skos:definition "An activity during which data is evaluated in relation to some specification or criteria, usually assessing its soundness, justifiability, or appropriateness for a specified purpose."@en ;
    skos:inScheme cdifact:conceptScheme ;
    skos:notation "DataValidation" ;
    skos:prefLabel "Data Validation"@en ;
    skos:topConceptOf cdifact:conceptScheme .

