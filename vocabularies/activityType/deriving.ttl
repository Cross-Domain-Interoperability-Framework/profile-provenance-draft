@prefix at: <https://w3id.org/cdif/provenance/activityType/> .
@prefix cdifact: <https://w3id.org/cdif/concepts/provenance/activity/> .
@prefix cdifprov: <https://w3id.org/cdif/provenance/> .
@prefix dag: <http://ddialliance.org/Specification/DDI-CDI/1.0/PROV/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

at:deriving a skos:Concept ;
    dcterms:isReplacedBy cdifact:Derivation ;
    owl:deprecated true ;
    skos:broader at:creating ;
    skos:definition "A creation process during which a new entity arises from parts or all of pre-existing entities."@en ;
    skos:editorialNote "Tentative in ProvWork2025: the workshop marked this class as a potential new category, a component of other classes, or something to fold into context."@en ;
    skos:exactMatch dag:Deriving ;
    skos:inScheme cdifprov:activityType ;
    skos:notation "deriving" ;
    skos:prefLabel "Deriving"@en .

