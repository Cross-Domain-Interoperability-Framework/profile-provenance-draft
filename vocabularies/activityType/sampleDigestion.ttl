@prefix at: <https://w3id.org/cdif/provenance/activityType/> .
@prefix cdifprov: <https://w3id.org/cdif/provenance/> .
@prefix dag: <http://ddialliance.org/Specification/DDI-CDI/1.0/PROV/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geochemvoc: <https://w3id.org/geochem/vocabulary/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

at:sampleDigestion a skos:Concept ;
    dcterms:isReplacedBy geochemvoc:sampleDigestion ;
    owl:deprecated true ;
    skos:broadMatch dag:IntentionalConditioning ;
    skos:broader at:samplePreparation ;
    skos:definition "Sample preparation that dissolves a solid sample, typically in acid, to produce a solution for analysis."@en ;
    skos:inScheme cdifprov:activityType ;
    skos:notation "sampleDigestion" ;
    skos:prefLabel "Sample digestion"@en .

