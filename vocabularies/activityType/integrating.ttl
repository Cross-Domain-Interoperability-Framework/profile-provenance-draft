@prefix at: <https://w3id.org/cdif/provenance/activityType/> .
@prefix cdifact: <https://w3id.org/cdif/concepts/provenance/activity/> .
@prefix cdifprov: <https://w3id.org/cdif/provenance/> .
@prefix dag: <http://ddialliance.org/Specification/DDI-CDI/1.0/PROV/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

at:integrating a skos:Concept ;
    dcterms:isReplacedBy cdifact:DataIntegration ;
    owl:deprecated true ;
    skos:definition "An activity during which multiple entities are unified into a coherent whole, often losing their distinctiveness."@en ;
    skos:editorialNote "Tentative in ProvWork2025: the workshop marked this class as a potential new category, a component of other classes, or something to fold into context."@en ;
    skos:exactMatch dag:Integrating ;
    skos:example "The incorporation of varied datasets using different semantics and formats into a common database, complying with its schema;"@en ;
    skos:inScheme cdifprov:activityType ;
    skos:notation "integrating" ;
    skos:prefLabel "Integrating"@en ;
    skos:topConceptOf cdifprov:activityType .

